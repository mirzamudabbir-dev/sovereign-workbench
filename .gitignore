# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Runtime state (never committed — regenerated on the venue machine)
data/
models/
run/

# policies/ holds committed Tetragon TracingPolicy source — do NOT ignore it

# Signing keys must never be committed — an accidentally committed signing key
# invalidates every receipt ever issued (data/ already covers this, but be explicit)
data/signing_key.pem
*.pem

# OS
.DS_Store
